# Copy this file to .env (same folder) and paste your key after the = sign.
# .env is listed in .gitignore, so the key is never committed.
ANTHROPIC_API_KEY=

# Or skip the key and run the agents through Claude Code instead:
# LLM_BACKEND=claude-code

# Optional overrides
# PLANNER_MODEL=claude-opus-5-5
# WORKER_MODEL=claude-sonnet-5-5
# CLAUDE_FALLBACKS=0
# Only if ngspice is not found automatically (Windows example):
# NGSPICE=C:\Spice64\bin\ngspice_con.exe
# Only if the claude command is not on PATH:
# CLAUDE_CLI=C:\Users\you\.local\bin\claude.exe
